{
  description = "nke-kubeadm-distro: one self-contained Kubernetes node stack .deb per pinned Kubernetes patch";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

  outputs =
    { self, nixpkgs }:
    let
      # The debs are amd64 and so is every artifact inside them, so the build
      # host is x86_64-linux. Nothing here is cross-compiled: the payload is
      # downloaded upstream release binaries, and only fpm/tar/gzip run.
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      lib = pkgs.lib;

      # versions.json is generated by ./prefetch.sh (`make lock`) and committed.
      # It is optional only so `nix build .#prefetch-tools` still works on a
      # checkout that has no lock yet -- that is how prefetch.sh gets the tools
      # to write the first one. Nothing else works without it: with no rows
      # `make debs` fails on a missing attribute, and `nix flake check` fails
      # outright, because versions-json-canonical reads the file.
      versions =
        if builtins.pathExists ./versions.json then
          builtins.fromJSON (builtins.readFile ./versions.json)
        else
          { };
      versionNames = builtins.attrNames versions;

      mkDeb =
        version:
        import ./deb.nix {
          inherit pkgs version;
          spec = versions.${version};
          # Every row conflicts with every other row in the matrix, not just the
          # ones this invocation happens to build: `make debs K8S_VERSIONS=...`
          # must not change what a package declares about its peers.
          peers = versionNames;
          postinstTemplate = ./postinst;
        };

      # deb-1_36_3, not deb-1.36.3: `nix build .#attr` splits the attribute path
      # on dots, so a dotted name would need quoting at every call site.
      debAttr = version: "deb-" + builtins.replaceStrings [ "v" "." ] [ "" "_" ] version;
      debs = lib.listToAttrs (map (v: lib.nameValuePair (debAttr v) (mkDeb v)) versionNames);

      # The tools prefetch.sh re-execs itself under, pinned to the same nixpkgs
      # as the build so `make lock` and `make debs` cannot disagree about skopeo.
      prefetchTools = pkgs.buildEnv {
        name = "kubeadm-distro-prefetch-tools";
        paths = with pkgs; [
          bash
          cacert
          coreutils
          curl
          diffutils
          gawk
          gnugrep
          gnupg
          gnused
          jq
          nix-prefetch-docker
          skopeo
        ];
      };
    in
    {
      packages.${system} = debs // {
        prefetch-tools = prefetchTools;
        # Exposed so the Makefile can run dpkg-scanpackages from the pinned
        # nixpkgs; the bake host then needs nothing but nix.
        inherit (pkgs) dpkg;
        # `nix build` with no attribute builds every row.
        default = pkgs.linkFarm "nke-kubeadm-distro-debs" (
          map (v: {
            name = (mkDeb v).debFileName;
            path = "${mkDeb v}/${(mkDeb v).debFileName}";
          }) versionNames
        );
      };

      checks.${system} = {
        # Cheap gates only: building a deb downloads about a gigabyte of images
        # per row, which is `make debs`, not `nix flake check`.
        postinst-shellcheck =
          pkgs.runCommand "postinst-shellcheck" { nativeBuildInputs = [ pkgs.shellcheck ]; }
            ''
              cp ${./postinst} postinst
              shellcheck --shell=bash postinst
              touch $out
            '';
        prefetch-shellcheck =
          pkgs.runCommand "prefetch-shellcheck" { nativeBuildInputs = [ pkgs.shellcheck ]; }
            ''
              cp ${./prefetch.sh} prefetch.sh
              shellcheck --shell=bash prefetch.sh
              touch $out
            '';
        # versions.json is machine-written; drift in its formatting means
        # someone hand-edited it, which is what the lock exists to stop.
        versions-json-canonical =
          pkgs.runCommand "versions-json-canonical"
            {
              nativeBuildInputs = [
                pkgs.jq
                pkgs.diffutils
              ];
            }
            ''
              jq -S --indent 2 . ${./versions.json} >canonical.json
              diff -u ${./versions.json} canonical.json
              touch $out
            '';
        # Instantiating every row catches a malformed versions.json entry
        # without fetching anything. It has to be .drvPath: .debFileName comes
        # straight off passthru, which a broken artifact or image entry never
        # touches, so reading it would pass on a row that cannot be built. The
        # string context is discarded so this stays an evaluation-time check
        # and does not pull a gigabyte of images per row.
        eval-all-debs = pkgs.runCommand "eval-all-debs" { } ''
          echo ${
            lib.concatMapStringsSep " " (v: builtins.unsafeDiscardStringContext (mkDeb v).drvPath) versionNames
          } >$out
        '';
      };

      formatter.${system} = pkgs.nixfmt-rfc-style;
    };
}
