# OS cruft
**/.DS_Store

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
.null*
bin/
dist
test-client/test-client
release
sample-clients/streaming-script/streaming-script
sample-clients/upload/upload
# The per-arch staging directories the deb build creates and removes.
# build/deb itself is listed too: it was NOT ignored before, which is how a
# stale DEBIAN/control from an old build ended up committed -- pinned at
# Version: 0.1.7 and missing Depends: libc6, so it disagreed with the real
# source in scripts/ that the build actually reads.
build/deb
build/deb_amd64
build/deb_arm64

# Build or CI artifacts.
/artifacts

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# editor and IDE paraphernalia
.idea
*.swp
*.swo
*~
report.xml
*.vscode

# Ignore any local ci files
.gitlab-ci-local/

# Local Go workspace files (developer-local tooling overrides)
go.work
go.work.sum
/agent

# Local consumer overrides (copy from config.env.example)
config.env
